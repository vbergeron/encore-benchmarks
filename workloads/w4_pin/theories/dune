(rocq.theory
 (name EncoreBench.W4)
 (modules Pin)
 (theories Stdlib EncoreBench.Common))

; Extraction is a separate rule because dune's rocq.extraction stanza only
; knows OCaml. The .scm is promoted into the source tree and committed, so
; firmware builds do not need Rocq; `dune build` keeps it in sync.
(rule
 (targets w4_pin.scm)
 (mode promote)
 (deps
  Pin.vo
  %{project_root}/theories/EncoreExtraction.vo
  %{project_root}/theories/EncoreInput.vo)
 (action
  (run rocq compile -w -extraction-default-directory -Q %{project_root}/theories EncoreBench.Common -Q . EncoreBench.W4
   %{dep:Extract.v})))
