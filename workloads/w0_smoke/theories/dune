(rocq.theory
 (name EncoreBench.W0)
 (modules Smoke)
 (theories Stdlib Encore.Extraction))

; Extraction is a separate rule because dune's rocq.extraction stanza only
; knows OCaml. The .scm is promoted into the source tree and committed, so
; firmware builds do not need Rocq; `dune build` keeps it in sync.
(rule
 (targets w0_smoke.scm)
 (mode promote)
 (deps Smoke.vo)
 (action
  (run rocq compile -w -extraction-default-directory -Q . EncoreBench.W0
   %{dep:Extract.v})))
